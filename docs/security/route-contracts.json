{
  "version": 1,
  "notes": "Executable route protection matrix. Patterns are intentionally grouped by product surface; tests fail when a route is not covered by one of these contracts.",
  "contracts": [
    { "id": "public-health", "routePattern": "/healthz", "methods": ["GET"], "auth": "public", "permission": null, "publicLink": false, "rateLimit": "none", "audit": "none", "freshAdminAuth": false },
    { "id": "public-ready", "routePattern": "/readyz", "methods": ["GET"], "auth": "public", "permission": null, "publicLink": false, "rateLimit": "none", "audit": "none", "freshAdminAuth": false },
    { "id": "public-version", "routePattern": "/api/version", "methods": ["GET"], "auth": "public", "permission": null, "publicLink": false, "rateLimit": "none", "audit": "none", "freshAdminAuth": false },
    { "id": "public-site-theme", "routePattern": "/api/site-theme", "methods": ["GET"], "auth": "public", "permission": null, "publicLink": false, "rateLimit": "none", "audit": "none", "freshAdminAuth": false },
    { "id": "public-auth-sso", "routePattern": "/api/auth/sso/**", "methods": ["GET", "POST"], "auth": "public-sso", "permission": null, "publicLink": false, "rateLimit": "login", "audit": "identity", "freshAdminAuth": false },
    { "id": "public-auth-entry", "routePattern": "/api/auth/{login,login/mfa,login/mfa/setup,login/mfa/setup/verify,register,forgot-password,reset-password,smtp-status}", "methods": ["GET", "POST"], "auth": "public-auth-flow", "permission": null, "publicLink": false, "rateLimit": "auth", "audit": "auth", "freshAdminAuth": false },
    { "id": "user-auth", "routePattern": "/api/auth/**", "methods": ["GET", "POST", "DELETE"], "auth": "user-session", "permission": "self", "publicLink": false, "rateLimit": "auth-write", "audit": "auth", "freshAdminAuth": false },
    { "id": "paste-public-read", "routePattern": "/api/paste/:id", "methods": ["GET"], "auth": "public-link", "permission": null, "publicLink": true, "rateLimit": "read", "audit": "event-log", "freshAdminAuth": false },
    { "id": "paste-create", "routePattern": "/api/paste", "methods": ["POST"], "auth": "user-or-guest", "permission": "guest paste link or user session", "publicLink": true, "rateLimit": "write", "audit": "event-log", "freshAdminAuth": false },
    { "id": "share-public", "routePattern": "/api/share/**", "methods": ["GET", "POST"], "auth": "public-link-or-user-or-guest", "permission": "guest share link for create", "publicLink": true, "rateLimit": "upload/read", "audit": "event-log", "freshAdminAuth": false },
    { "id": "share-create-root", "routePattern": "/api/share", "methods": ["POST"], "auth": "user-or-guest", "permission": "guest share link or user session", "publicLink": true, "rateLimit": "upload", "audit": "event-log", "freshAdminAuth": false },
    { "id": "extension-api", "routePattern": "/api/ext/**", "methods": ["GET", "POST", "PUT", "DELETE"], "auth": "extension-bearer", "permission": "role permission where applicable", "publicLink": false, "rateLimit": "extension/auth", "audit": "auth/event-log", "freshAdminAuth": false },
    { "id": "service-api", "routePattern": "/api/v1/**", "methods": ["GET", "POST"], "auth": "service-account-bearer", "permission": "service account scope", "publicLink": false, "rateLimit": "api", "audit": "api", "freshAdminAuth": false },
    { "id": "chat-api", "routePattern": "/api/chat/**", "methods": ["GET", "POST", "PUT", "DELETE"], "auth": "user-session", "permission": "conversation membership", "publicLink": false, "rateLimit": "chat", "audit": "event-log", "freshAdminAuth": false },
    { "id": "avatar-api", "routePattern": "/api/avatar/**", "methods": ["GET", "POST", "DELETE"], "auth": "user-session", "permission": "self", "publicLink": false, "rateLimit": "upload/write", "audit": "event-log", "freshAdminAuth": false },
    { "id": "avatar-root", "routePattern": "/api/avatar", "methods": ["POST", "DELETE"], "auth": "user-session", "permission": "self", "publicLink": false, "rateLimit": "upload/write", "audit": "event-log", "freshAdminAuth": false },
    { "id": "vault-api", "routePattern": "/api/vault/**", "methods": ["GET", "POST", "PUT", "DELETE"], "auth": "user-session", "permission": "vault membership", "publicLink": false, "rateLimit": "vault", "audit": "vault audit", "freshAdminAuth": false },
    { "id": "calendar-api", "routePattern": "/api/calendar/**", "methods": ["GET", "POST", "PUT", "DELETE"], "auth": "user-session", "permission": "calendar.view/calendar.view_team/calendar.manage", "publicLink": false, "rateLimit": "calendar", "audit": "event-log", "freshAdminAuth": false },
    { "id": "survey-api", "routePattern": "/api/survey/**", "methods": ["GET", "POST", "PUT", "DELETE"], "auth": "user-session-or-public-response", "permission": "survey.create/survey.manage_any/survey.view_results_any or response token", "publicLink": true, "rateLimit": "survey", "audit": "event-log", "freshAdminAuth": false },
    { "id": "survey-root", "routePattern": "/api/survey", "methods": ["POST"], "auth": "user-session", "permission": "survey.create", "publicLink": false, "rateLimit": "survey", "audit": "event-log", "freshAdminAuth": false },
    { "id": "wiki-api", "routePattern": "/api/wiki/**", "methods": ["GET", "POST", "PUT", "PATCH", "DELETE"], "auth": "user-session", "permission": "wiki permission set", "publicLink": false, "rateLimit": "wiki", "audit": "event-log", "freshAdminAuth": false },
    { "id": "threat-api", "routePattern": "/api/threat/**", "methods": ["GET", "POST", "PUT", "DELETE"], "auth": "user-session", "permission": "threat.view/threat.manage", "publicLink": false, "rateLimit": "threat", "audit": "event-log", "freshAdminAuth": false },
    { "id": "reporter-api", "routePattern": "/api/reporter/**", "methods": ["GET", "POST", "PUT", "DELETE"], "auth": "user-session", "permission": "reporter permission plus project membership", "publicLink": false, "rateLimit": "reporter", "audit": "event-log", "freshAdminAuth": false },
    { "id": "engage-api", "routePattern": "/api/engage/**", "methods": ["GET", "POST", "PUT", "DELETE"], "auth": "user-session", "permission": "engage permission set", "publicLink": false, "rateLimit": "engage", "audit": "engage activity/audit", "freshAdminAuth": false },
    { "id": "homepage-api", "routePattern": "/api/homepage/**", "methods": ["GET", "POST", "PUT", "DELETE"], "auth": "user-session", "permission": "bulletin/homepage permission where applicable", "publicLink": false, "rateLimit": "homepage", "audit": "event-log", "freshAdminAuth": false },
    { "id": "notifications-api", "routePattern": "/api/notifications/**", "methods": ["GET", "POST", "PUT", "DELETE"], "auth": "user-session", "permission": "self", "publicLink": false, "rateLimit": "notifications", "audit": "event-log", "freshAdminAuth": false },
    { "id": "notifications-root", "routePattern": "/api/notifications", "methods": ["GET"], "auth": "user-session", "permission": "self", "publicLink": false, "rateLimit": "notifications", "audit": "event-log", "freshAdminAuth": false },
    { "id": "redsecai-api", "routePattern": "/api/ai/**", "methods": ["GET", "POST"], "auth": "user-session", "permission": "scoped tool permissions", "publicLink": false, "rateLimit": "ai", "audit": "confirmed/rejected actions", "freshAdminAuth": false },
    { "id": "admin-login", "routePattern": "/admin/login", "methods": ["POST"], "auth": "admin-password-plus-user-session-after-bootstrap", "permission": "admin", "publicLink": false, "rateLimit": "admin-login", "audit": "auth", "freshAdminAuth": false },
    { "id": "admin-openapi-ui", "routePattern": "/admin/openapi", "methods": ["GET"], "auth": "admin-cookie-and-linked-user-session", "permission": "admin", "publicLink": false, "rateLimit": "admin", "audit": "none", "freshAdminAuth": false },
    { "id": "admin-openapi-init", "routePattern": "/admin/openapi/init.js", "methods": ["GET"], "auth": "admin-cookie-and-linked-user-session", "permission": "admin", "publicLink": false, "rateLimit": "admin", "audit": "none", "freshAdminAuth": false },
    { "id": "admin-openapi-controls-css", "routePattern": "/admin/openapi/controls.css", "methods": ["GET"], "auth": "admin-cookie-and-linked-user-session", "permission": "admin", "publicLink": false, "rateLimit": "admin", "audit": "none", "freshAdminAuth": false },
    { "id": "admin-openapi-proxy", "routePattern": "/admin/openapi/proxy", "methods": ["POST"], "auth": "admin-cookie-and-linked-user-session", "permission": "admin", "publicLink": false, "rateLimit": "admin", "audit": "api", "freshAdminAuth": false },
    { "id": "admin-docs", "routePattern": "/admin/docs/:docId", "methods": ["GET"], "auth": "admin-cookie-and-linked-user-session", "permission": "admin", "publicLink": false, "rateLimit": "admin", "audit": "none", "freshAdminAuth": false },
    { "id": "admin-api-read", "routePattern": "/admin/api/**", "methods": ["GET"], "auth": "admin-cookie-and-linked-user-session", "permission": "admin", "publicLink": false, "rateLimit": "admin", "audit": "admin/audit", "freshAdminAuth": false },
    { "id": "admin-api-write", "routePattern": "/admin/api/**", "methods": ["POST", "PUT", "PATCH", "DELETE"], "auth": "admin-cookie-and-linked-user-session", "permission": "admin", "publicLink": false, "rateLimit": "admin-write", "audit": "admin/audit", "freshAdminAuth": "high-risk writes" },
    { "id": "admin-logout", "routePattern": "/admin/logout", "methods": ["POST"], "auth": "admin-cookie", "permission": "admin", "publicLink": false, "rateLimit": "none", "audit": "auth", "freshAdminAuth": false },
    { "id": "minitools-api", "routePattern": "/api/minitools/**", "methods": ["GET", "POST"], "auth": "user-session", "permission": "minitools.view", "publicLink": false, "rateLimit": "minitools", "audit": "event-log", "freshAdminAuth": false },
    { "id": "minitools-callback-delete", "routePattern": "/api/minitools/callback/**", "methods": ["DELETE"], "auth": "user-session", "permission": "minitools.view", "publicLink": false, "rateLimit": "minitools", "audit": "event-log", "freshAdminAuth": false }
  ]
}
