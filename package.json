{
  "name": "redsecpaste",
  "version": "2.0.0",
  "private": true,
  "description": "RedSecPaste — Encrypted pastebin by RedSec Offensive Security",
  "scripts": {
    "dev": "concurrently \"nodemon server/index.js\" \"npx tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch\"",
    "build": "npx tailwindcss -i ./public/css/input.css -o ./public/css/style.css --minify",
    "start": "node server/index.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "sharp": "^0.34.5",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "nodemon": "^3.1.0",
    "tailwindcss": "^3.4.0"
  }
}
