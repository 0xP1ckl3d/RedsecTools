# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Admin dashboard password (required for /admin to work)
# Run ./setup.sh (Linux/macOS/Git Bash) or .\setup.ps1 (Windows) to auto-generate.
# Or set your own strong password below:
ADMIN_PASSWORD=changeme

# Secret for signing cookies (32-byte hex string, auto-generated by setup script)
# To generate manually: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=generate-a-random-secret-here

# Cookie secure flag. Defaults to true when NODE_ENV=production.
# Set false only for local HTTP deployments.
COOKIE_SECURE=true

# Database path (default: ./data/pastes.db)
# DB_PATH=./data/pastes.db

# RedSecReporter PDF rendering.
# Docker sets PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium automatically.
# For non-Docker installs, set this if Chrome/Chromium is not in a standard path.
REPORTER_PDF_TIMEOUT_MS=120000
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Comma-separated list of trusted public origins used for invite, reset-password,
# and guest links. Add every URL users/admins will access the app through.
# Examples:
# TRUSTED_PUBLIC_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# TRUSTED_PUBLIC_ORIGINS=https://tools.example.com,https://tools.internal.example.com
TRUSTED_PUBLIC_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP is configured via the Admin > Settings UI (stored in database).
# No SMTP env vars are needed — configure it after logging into /admin.
