# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Admin dashboard password (required for /admin to work)
# Run ./setup.sh (Linux/macOS/Git Bash) or .\setup.ps1 (Windows) to auto-generate.
# Or set your own strong password below:
ADMIN_PASSWORD=changeme

# Secret for signing cookies (32-byte hex string, auto-generated by setup script)
# To generate manually: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=generate-a-random-secret-here

# Database path (default: ./data/pastes.db)
# DB_PATH=./data/pastes.db

# SMTP is configured via the Admin > Settings UI (stored in database).
# No SMTP env vars are needed — configure it after logging into /admin.
